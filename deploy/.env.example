# The server's settings, in /opt/thrill/.env (mode 600, owner deploy). Never commit it.
# deploy/server/bootstrap.sh creates it from this file and fills in the four secrets.
# By hand, generate secrets with:  openssl rand -hex 32
# Every value here reaches the containers; none of it goes to GitHub.

# ------------------------------------------------------------------ Site --
SITE_DOMAIN=thrillrwanda.com
# NEXT_PUBLIC_SITE_URL is also fixed into the browser code when GitHub Actions
# builds the image (repository variable SITE_URL); keep the two the same.
NEXT_PUBLIC_SITE_URL=https://thrillrwanda.com
BETTER_AUTH_URL=https://thrillrwanda.com
APP_ENV=production
SOFT_LAUNCH_PRIVATE=false
# Loopback port of Thrill's proxy; the server's Caddy forwards thrillrwanda.com
# here (deploy/host-caddy/thrillrwanda.caddy uses the same number).
PROXY_PORT=4100

# ------------------------------------------------------------- Deploys --
# Where the images are published. Lowercase; default shown.
# IMAGE_REPO=ghcr.io/alleluiacervi-tech/thrill-rwanda
# Database connections per container (app, scheduler). Postgres allows 60.
DATABASE_POOL_MAX=10
# Optional heartbeat pinged after each nightly backup (healthchecks.io style).
BACKUP_HEARTBEAT_URL=

# -------------------------------------------------------------- Secrets --
# Letters and digits only (it goes inside the database address).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
CRON_SECRET=
# openssl rand -base64 32   (keep a copy OFF the server: without it backups can't be read)
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP_DAYS=14

# Team members must use an authenticator app. Leave as is in production.
# TEAM_TWO_FACTOR=optional

# ---------------------------------------------------------------- Email --
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_DOMAIN=

# Admin mail: the shared Spacemail inbox (docs/ADMIN_MAIL.md).
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Thrill Rwanda
# MAIL_IMAP_HOST=mail.spacemail.com
# MAIL_SMTP_HOST=mail.spacemail.com

# -------------------------------------------------------- Image uploads --
# Production needs Cloudinary or R2; with neither, uploads are switched off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Fallback driver, used only when Cloudinary is not set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------------------------------------------------- Flights (Duffel) --
# A TEST token (duffel_test_...) returns sandbox fares and never issues tickets.
# A live token is refused unless DUFFEL_ALLOW_LIVE=true (owner decision).
DUFFEL_ACCESS_TOKEN=
# DUFFEL_ALLOW_LIVE=true
# Flight board prices. Choose the source in Admin → Fares (Off, Duffel or
# Skyscanner); these are only the keys. Duffel needs a LIVE token and
# DUFFEL_ALLOW_LIVE=true; sandbox fares are never published.
# SKYSCANNER_API_KEY=
# SKYSCANNER_MARKET=UK
# SKYSCANNER_CURRENCY=USD
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_CURRENCY=USD
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_PROJECT_ID=

# ------------------------------------------------------ Search engines --
# The content value of the HTML-tag verification from Google Search Console
# (and Bing Webmaster Tools). docs/FARES_SEO_PAYMENTS_PLAN.md
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ------------------------------------------------------------- Payments --
URUBUTOPAY_ENABLED=false
URUBUTOPAY_ENVIRONMENT=staging
URUBUTOPAY_LIVE_APPROVED=false
PAYMENT_PUBLIC_ORIGIN=
URUBUTOPAY_MERCHANT_CODE=
URUBUTOPAY_SERVICE_CODE=
URUBUTOPAY_API_KEY=
URUBUTOPAY_APPROVED_METHODS=
URUBUTOPAY_MIN_RWF=
URUBUTOPAY_MAX_RWF=
URUBUTOPAY_WEBHOOK_USERNAME=
URUBUTOPAY_WEBHOOK_PASSWORD=
URUBUTOPAY_WEBHOOK_SECRET=
PESAPAL_LEGACY_RECONCILE=false
PESAPAL_ENV=sandbox
PESAPAL_LIVE_APPROVED=false
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

TRANSFER_ROUTE_ESTIMATES_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_KGL_PLACE_ID=

# Optional channels stay off until approved.
MAINTENANCE_DELETE_APPROVED=false
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Live MTN Rwanda Collections (official API). Off until MTN approves go-live; see docs/PAYMENT_INTEGRATION.md.
MTN_ENABLED=false
MTN_LIVE_APPROVED=false
# Production Collections root from the MTN merchant pack, ending in /collection
MTN_BASE_URL=
# X-Target-Environment value from the merchant pack
MTN_TARGET_ENVIRONMENT=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_MIN_RWF=
MTN_MAX_RWF=
