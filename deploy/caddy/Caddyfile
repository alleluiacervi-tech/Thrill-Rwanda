# Thrill's internal proxy (the "proxy" service). Plain HTTP on the server's
# loopback only; HTTPS, certificates and the public address are handled by
# the server's own Caddy (deploy/host-caddy/thrillrwanda.caddy).
{
	auto_https off
	servers {
		# The server's Caddy (reaching us through Docker's gateway) has
		# already set X-Forwarded-For to the real visitor; keep it.
		trusted_proxies static private_ranges
	}
}

:80 {
	# Scheduled-job routes are for the scheduler inside the server only.
	@cron path /api/cron/*
	respond @cron 404

	# Every running "app" container is an upstream: Docker's DNS returns one
	# address per container. During a deploy the new and old containers both
	# answer, and a request that can't reach one is retried on the other, so a
	# rollout drops nothing. deploy-gate waits for the new container's health
	# check before stopping the old one.
	reverse_proxy {
		dynamic a {
			name app
			port 3000
			refresh 1s
			dial_timeout 2s
		}
		lb_policy round_robin
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 10s
	}

	log {
		output stdout
		format console
	}
}
