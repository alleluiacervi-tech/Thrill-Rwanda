# ---------------------------------------------------------------- Core ----
SOFT_LAUNCH_PRIVATE="false" # When true, public pages/intake require staff or explicitly granted client access.
APP_ENV="development" # development | test | staging | production; separate DB/accounts/secrets per deployment
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------ Database ----
# Local PostgreSQL started with `npm run db:local`.
DATABASE_URL="postgresql://postgres:thrill-rwanda-local@127.0.0.1:54329/thrill_rwanda?schema=public"
DIRECT_URL="postgresql://postgres:thrill-rwanda-local@127.0.0.1:54329/thrill_rwanda?schema=public"

# ---------------------------------------------------------------- Auth ----
BETTER_AUTH_SECRET=""  # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------- Payments ---
# Pesapal is the gateway — it settles M-Pesa and cards in one integration.
PESAPAL_ENV="sandbox"  # sandbox by default; live additionally requires explicit approval

# Optional UrubutoPay staging checkout, available to administrators.
URUBUTO_PAY_TEST_KEY=""
URUBUTO_PAY_MERCHANT_CODE=""
URUBUTO_PAY_SERVICE_CODE=""
PESAPAL_LIVE_APPROVED="false"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
# Register the IPN URL once per environment, then paste the id it prints:
#   npm run pesapal:ipn -- https://your-domain/api/payments/pesapal/ipn
PESAPAL_IPN_ID=""

# ---------------------------------------------------------------- Email ---
RESEND_API_KEY=""
# Add a sender on a domain you own and have verified with Resend.
EMAIL_FROM=""

GOOGLE_MAPS_API_KEY=""

# --------------------------------------------------------------- Storage --
# Cloudinary is the upload driver. All three required; never NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 — fallback, used only if the Cloudinary vars above are unset.
# With neither set, dev writes to .uploads/ and production refuses the upload.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Shared authorization for protected cron endpoints; set securely in deployment settings.
CRON_SECRET=""

# -------------------------------------------------- Backups and retention --
# Generate a dedicated backup-only key: openssl rand -base64 32
# Store it separately from encrypted archives; never commit or enter it in the admin evidence register.
BACKUP_ENCRYPTION_KEY=""
# Optional full paths to installed PostgreSQL client binaries matching the DB server.
PG_DUMP_BIN="pg_dump"
PG_RESTORE_BIN="pg_restore"
# Dry run unless BOTH this approval flag and the approved document policy allow deletion.
MAINTENANCE_DELETE_APPROVED="false"

# ------------------------------------------------------- Optional WhatsApp --
# Requires company-owned Meta account, approved template and release evidence in Admin -> Readiness.
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Body parameters: 1 = enquiry reference, 2 = current status. No itinerary or identity documents.
WHATSAPP_STATUS_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Standard pg driver pool; use the deployment's connection budget.
DATABASE_POOL_MAX="5"
