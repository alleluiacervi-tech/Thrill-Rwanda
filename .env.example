# ---------------------------------------------------------------- Core ----
SOFT_LAUNCH_PRIVATE="false" # When true, public pages/intake require staff or explicitly granted client access.
APP_ENV="development" # development | test | staging | production; separate DB/accounts/secrets per deployment
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------ Database ----
# Local PostgreSQL started with `npm run db:local`.
DATABASE_URL="postgresql://postgres:thrill-rwanda-local@127.0.0.1:54329/thrill_rwanda?schema=public"
DIRECT_URL="postgresql://postgres:thrill-rwanda-local@127.0.0.1:54329/thrill_rwanda?schema=public"

# ---------------------------------------------------------------- Auth ----
BETTER_AUTH_SECRET=""  # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------- Payments ---
# UrubutoPay online collections. Keep disabled until onboarding and testing.
URUBUTOPAY_ENABLED="false"
URUBUTOPAY_ENVIRONMENT="staging"
URUBUTOPAY_LIVE_APPROVED="false"
PAYMENT_PUBLIC_ORIGIN=""
URUBUTOPAY_MERCHANT_CODE=""
URUBUTOPAY_SERVICE_CODE=""
URUBUTOPAY_API_KEY=""
URUBUTOPAY_APPROVED_METHODS=""  # MOMO,AIRTEL_MONEY,CARD as approved
URUBUTOPAY_MIN_RWF=""
URUBUTOPAY_MAX_RWF=""
URUBUTOPAY_WEBHOOK_USERNAME=""
URUBUTOPAY_WEBHOOK_PASSWORD=""
URUBUTOPAY_WEBHOOK_SECRET=""

# Optional sandbox-only MTN adapter. It is separate from customer routing.
MTN_SANDBOX_ENABLED="false"
MTN_SANDBOX_SUBSCRIPTION_KEY=""
MTN_SANDBOX_API_USER=""
MTN_SANDBOX_API_KEY=""

# Optional isolated UrubutoPay administrator test utility.
URUBUTO_PAY_TEST_KEY=""
URUBUTO_PAY_MERCHANT_CODE=""
URUBUTO_PAY_SERVICE_CODE=""
# Legacy verification during cutover. New orders use the collection service.
PESAPAL_LEGACY_RECONCILE="false"
PESAPAL_ENV="sandbox"
PESAPAL_LIVE_APPROVED="false"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# ---------------------------------------------------------------- Email ---
RESEND_API_KEY=""

# Company mailbox on Spacemail, shown in Admin > Mail (read, send, drafts...).
# Set these in the host secrets, never in the repo. Hosts and ports default to Spacemail.
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM_NAME="Thrill Rwanda"
# MAIL_IMAP_HOST="mail.spacemail.com"  MAIL_IMAP_PORT="993"
# MAIL_SMTP_HOST="mail.spacemail.com"  MAIL_SMTP_PORT="465"
# Add a sender on a domain you own and have verified with Resend.
EMAIL_FROM=""

# Optional Kigali airport sedan estimates (server only).
TRANSFER_ROUTE_ESTIMATES_ENABLED="false"
GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_KGL_PLACE_ID=""

# --------------------------------------------------------------- Storage --
# Cloudinary is the upload driver. All three required; never NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 — fallback, used only if the Cloudinary vars above are unset.
# With neither set, dev writes to .uploads/ and production refuses the upload.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Shared authorization for protected cron endpoints; set securely in deployment settings.
CRON_SECRET=""

# -------------------------------------------------- Backups and retention --
# Generate a dedicated backup-only key: openssl rand -base64 32
# Store it separately from encrypted archives; never commit or enter it in the admin evidence register.
BACKUP_ENCRYPTION_KEY=""
# Optional full paths to installed PostgreSQL client binaries matching the DB server.
PG_DUMP_BIN="pg_dump"
PG_RESTORE_BIN="pg_restore"
# Dry run unless BOTH this approval flag and the approved document policy allow deletion.
MAINTENANCE_DELETE_APPROVED="false"

# ------------------------------------------------------- Optional WhatsApp --
# Requires company-owned Meta account, approved template and release evidence in Admin -> Readiness.
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Body parameters: 1 = enquiry reference, 2 = current status. No itinerary or identity documents.
WHATSAPP_STATUS_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Standard pg driver pool; use the deployment's connection budget.
DATABASE_POOL_MAX="5"

# Live MTN Rwanda Collections (official API). Off until MTN approves go-live; see docs/PAYMENT_INTEGRATION.md.
MTN_ENABLED=false
MTN_LIVE_APPROVED=false
# Production Collections root from the MTN merchant pack, ending in /collection
MTN_BASE_URL=
# X-Target-Environment value from the merchant pack
MTN_TARGET_ENVIRONMENT=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_MIN_RWF=
MTN_MAX_RWF=

# Duffel flight API (live fares and bookings in the ticketing desk). Use a TEST token
# (duffel_test_...) from the Duffel dashboard: it returns sandbox fares and never
# issues real tickets. A live token is refused unless DUFFEL_ALLOW_LIVE=true.
DUFFEL_ACCESS_TOKEN=""
# DUFFEL_ALLOW_LIVE="true"
# Flight board prices: the source (Off, Duffel, Skyscanner) is chosen in
# Admin → Fares; only the keys live here. Duffel needs a live token above.
# Locally, /flights?fares=sample (&source=skyscanner) shows invented fares to
# review the design.
# SKYSCANNER_API_KEY=""
# SKYSCANNER_MARKET="UK"
# SKYSCANNER_CURRENCY="USD"
# TRAVELPAYOUTS_TOKEN=""
# TRAVELPAYOUTS_CURRENCY="USD"

# Search Console / Bing Webmaster Tools: the HTML-tag verification content value.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
