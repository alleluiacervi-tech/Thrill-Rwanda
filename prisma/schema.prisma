// Thrill Rwanda — data model
// See docs/ARCHITECTURE.md for the three rules this schema encodes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ================================================================ ENUMS ==
 */

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderKind {
  CAR
  HOTEL
  TOUR
}

enum ProviderStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ServiceType {
  TOUR
  ROOM
  VEHICLE
  TRANSFER
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  CARD
  BANK_TRANSFER
  CASH
  MTN_MOMO
  AIRTEL_MONEY
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

/**
 * ================================================================ USERS ==
 */

model User {
  clientCaseAccess ClientCaseAccess[]
  corporateMemberships CorporateMember[]
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  fullName      String   @map("full_name")
  phone         String?
  role          Role     @default(CUSTOMER)
  staffRole     StaffRole? @map("staff_role")
  /// An administrator who may also grant and remove everyone's access. Only
  /// meaningful with role ADMIN; at least one active super admin must remain.
  isSuperAdmin  Boolean  @default(false) @map("is_super_admin")
  /// Two-step sign-in with an authenticator app is switched on (Better Auth two-factor plugin).
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactors    TwoFactor[]
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assignedEnquiries Enquiry[] @relation("EnquiryOwner")
  enquiryActivities EnquiryActivity[]
  provider      Provider?
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]

  @@index([role])
  @@map("users")
}

/// Better Auth two-factor: the authenticator secret and backup codes for one
/// account, both stored encrypted by Better Auth. Never shown or exported.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  /// False until the first code from the authenticator app has been checked.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

/// Better Auth session store.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String?
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Email verification and password-reset tokens.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

/**
 * ============================================================ PROVIDERS ==
 */

model Provider {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @map("user_id") @db.Uuid
  businessName  String         @map("business_name")
  slug          String         @unique

  kind          ProviderKind   @default(TOUR)
  /// Every category this provider may list in. Empty means [kind] — see providerKinds().
  kinds         ProviderKind[] @default([])
  about         String?
  phone         String?
  city          String?
  address       String?
  /// KRA PIN / tourism licence / insurance refs
  kraPin        String?        @map("kra_pin")
  licenceNumber String?        @map("licence_number")
  documents     Json?
  status        ProviderStatus @default(PENDING)
  verifiedAt    DateTime?      @map("verified_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tours    Tour[]
  hotels   Hotel[]
  vehicles Vehicle[]
  bookings Booking[]

  @@index([status])
  @@map("providers")
}

/**
 * ============================================================ INVENTORY ==
 */

model Tour {
  /// Which way of travelling this offer is filed under: SAFARI, PRIVATE_LUXURY,
  /// HONEYMOON, CITY_TOUR, TEMBERA or SCHOOL (src/lib/journey-requests.ts). Null is unfiled.
  collection String?
  /// Sold by written quote only, even while trips can be booked directly (Admin → Launch).
  enquiryOnly Boolean @default(false) @map("enquiry_only")
  /// Runs only on the dates in tour_departures. Any other start date is refused.
  fixedDepartures Boolean @default(false) @map("fixed_departures")
  departures TourDeparture[]
  itinerary String @default("")
  suitability String @default("")
  inclusions String[] @default([])
  exclusions String[] @default([])
  offerApproval String? @map("offer_approval")
  id              String   @id @default(uuid()) @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  name            String
  slug            String   @unique
  destination     String
  description     String?
  images          String[] @default([])
  durationDays    Int      @map("duration_days") @db.SmallInt
  activities      String[] @default([])
  pickupInfo      String?  @map("pickup_info")
  maxParticipants Int      @map("max_participants") @db.SmallInt
  /// Minor units (USD cents). Never a float. This is the East African citizen rate.
  priceMinor      Int      @map("price_minor")
  /// Residents of East Africa who are not citizens. Null means the citizen rate applies.
  priceResidentMinor    Int? @map("price_resident_minor")
  // Non-residents of East Africa. Null means the citizen rate applies.
  priceNonResidentMinor Int? @map("price_non_resident_minor")
  currency        String   @default("USD")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([destination])
  @@index([providerId])
  @@index([collection])
  @@map("tours")
  
}

/// A place Thrill Rwanda can reserve for a wedding or event. Venues are
/// reserved on the customer's behalf after a written quote: there is no
/// price and no calendar here, only what helps a couple choose.
model Venue {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  /// One of VENUE_KINDS (src/lib/venue-rules.ts), e.g. "Garden or lakeshore".
  kind        String
  /// Town or area, as a guest would say it: "Kigali", "Rubavu, Lake Kivu".
  location    String
  /// Most guests the venue takes.
  capacity    Int      @db.SmallInt
  description String
  /// Short facts: "On-site catering", "Parking for 80 cars".
  features    String[] @default([])
  images      String[] @default([])
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isPublished])
  @@map("venues")
}

/// Who did what, and when: one row per change made by a team member
/// (administrators, staff and providers) and per team sign-in.
///
/// Append-only. A database trigger (migration activity_log) rejects any
/// UPDATE or DELETE, so an entry cannot be altered or removed afterwards,
/// not even by the application. The actor is copied in, not linked, so the
/// record survives the account being deleted.
model BusinessVenue {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  kind        String
  description String
  source      String?
  image       String?
  isPublished Boolean  @default(false) @map("is_published")
  spaces      BusinessVenueSpace[]
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("business_venues")
}

model BusinessVenueSpace {
  id        String        @id @default(uuid()) @db.Uuid
  venueId   String        @map("venue_id") @db.Uuid
  venue     BusinessVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)
  name      String
  type      String
  capacities Json
  maximum   Int?
  features  String?
  isPublished Boolean     @default(false) @map("is_published")
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([venueId, name])
  @@map("business_venue_spaces")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name")
  actorEmail String   @map("actor_email")
  /// The actor's access at the time: "Super admin", "Admin", "Sales", "Provider"...
  actorRole  String   @map("actor_role")
  /// Short machine name, e.g. "user.role", "venue.publish", "tour.update".
  action     String
  /// The part of the business: "Access", "Listings", "Bookings", "Finance"...
  area       String
  /// What was acted on, as people would name it: "Amina Uwimana", "Garden Pavilion".
  target     String?
  targetId   String?  @map("target_id")
  /// One readable sentence: "Changed role from Customer to Admin".
  summary    String
  /// Before and after, where it helps.
  changes    Json     @default("{}")
  ip         String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([area, createdAt])
  @@index([targetId])
  @@map("activity_logs")
}

/// A dated run of a fixed-departure tour (a Tembera u Rwanda edition).
/// Seats are not stored here: they are the tour's own capacity, held day by
/// day in `availability` like every other booking, so one inventory decides.
model TourDeparture {
  id        String   @id @default(uuid()) @db.Uuid
  tourId    String   @map("tour_id") @db.Uuid
  /// First day. The run lasts the tour's durationDays.
  startsOn  DateTime @map("starts_on") @db.Date
  /// Optional line shown with the date, e.g. "Umuganura weekend".
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, startsOn])
  @@index([startsOn])
  @@map("tour_departures")
}

model Hotel {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  name        String
  slug        String   @unique
  location    String
  description String?
  images      String[] @default([])
  amenities   String[] @default([])
  stars       Int?     @db.SmallInt
  latitude    Float?
  longitude   Float?
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@index([location])
  @@index([providerId])
  @@map("hotels")
}

model Room {
  id                 String   @id @default(uuid()) @db.Uuid
  hotelId            String   @map("hotel_id") @db.Uuid
  name               String
  description        String?
  images             String[] @default([])
  capacity           Int      @db.SmallInt
  /// How many physical rooms of this type exist — the availability cap.
  quantity           Int      @default(1) @db.SmallInt
  pricePerNightMinor Int      @map("price_per_night_minor")
  currency           String   @default("USD")
  isPublished        Boolean  @default(false) @map("is_published")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("rooms")
}

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @map("provider_id") @db.Uuid
  make         String
  model        String
  year         Int      @db.SmallInt
  slug         String   @unique
  category     String
  images       String[] @default([])
  seats        Int      @db.SmallInt
  transmission String
  fuelType     String   @map("fuel_type")
  features     String[] @default([])

  quantity         Int     @default(1) @db.SmallInt
  pricePerDayMinor Int     @map("price_per_day_minor")
  /// Extra per day when the customer wants a driver. Null means this vehicle is self-drive only.
  driverPerDayMinor Int?   @map("driver_per_day_minor")
  /// What the customer is liable for if the vehicle is damaged. Set per vehicle by the provider.
  insuranceChargeMinor Int? @map("insurance_charge_minor")
  currency         String  @default("USD")
  isPublished      Boolean @default(false) @map("is_published")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([category])
  @@map("vehicles")
}

/**
 * ========================================================= AVAILABILITY ==
 */

/// One row per bookable resource per day.

model Availability {
  serviceType        ServiceType @map("service_type")
  resourceId         String      @map("resource_id") @db.Uuid
  day                DateTime    @db.Date
  unitsTotal         Int         @map("units_total") @db.SmallInt
  unitsBooked        Int         @default(0) @map("units_booked") @db.SmallInt
  /// Optional per-day override; falls back to the listing price.
  priceOverrideMinor Int?        @map("price_override_minor")
  isBlocked          Boolean     @default(false) @map("is_blocked")

  @@id([serviceType, resourceId, day])
  @@index([serviceType, resourceId, day])
  @@map("availability")
}

/**
 * ============================================================= BOOKINGS ==
 */

/// ONE booking table for all four products.

model Booking {
  supportCases SupportCase[]
  id         String @id @default(uuid()) @db.Uuid
  /// Human-facing reference, e.g. SW-8F3K2Q. Shown on confirmations.
  reference  String @unique
  customerId String @map("customer_id") @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  serviceType ServiceType @map("service_type")
  resourceId  String      @map("resource_id") @db.Uuid

  startDate DateTime @map("start_date") @db.Date
  /// Exclusive end. For a single-day service, startDate + 1.
  endDate   DateTime @map("end_date") @db.Date
  guests    Int      @default(1) @db.SmallInt
  units     Int      @default(1) @db.SmallInt

  /// Priced at booking time — never recomputed from the live listing.
  subtotalMinor Int    @map("subtotal_minor")
  totalMinor    Int    @map("total_minor")
  currency      String @default("USD")

  status BookingStatus @default(PENDING)

  /// Type-specific payload: flightNumber, pickupPoint, specialRequests…
  details Json @default("{}")

  customerNotes      String?   @map("customer_notes")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer User      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  payments Payment[]
  paymentInvoice PaymentInvoice?
  review   Review?
  agreement BookingAgreement?
  documents BookingDocument[]
  enquiryFulfilment EnquiryFulfilment?

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([serviceType, resourceId])
  @@map("bookings")
}

/**
 * ============================================================= PAYMENTS ==
 */

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  /// Gateway's id — M-Pesa receipt, Pesapal tracking id, etc.
  transactionId   String?       @unique @map("transaction_id")
  /// Our idempotency key, sent to the gateway and echoed back.
  idempotencyKey  String        @unique @map("idempotency_key")
  amountMinor     Int           @map("amount_minor")
  currency        String        @default("USD")
  gateway         String        @default("PESAPAL")
  method          PaymentMethod
  status          PaymentStatus @default(INITIATED)
  gatewayResponse Json?         @map("gateway_response")
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model PaymentInvoice {
  id           String @id @default(uuid()) @db.Uuid
  number       String @unique
  bookingId    String? @unique @map("booking_id") @db.Uuid
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  caseId       String? @unique @map("case_id") @db.Uuid
  financialCase FinancialCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  currency     String
  totalMinor   Int @map("total_minor")
  depositMinor Int @map("deposit_minor")
  dueAt        DateTime? @map("due_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  link         PaymentLink?
  attempts     CollectionAttempt[]
  @@map("payment_invoices")
}

model PaymentLink {
  invoiceId String @id @map("invoice_id") @db.Uuid
  invoice   PaymentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  tokenHash String @unique @map("token_hash")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  @@map("payment_links")
}

model CollectionAttempt {
  id                 String @id @default(uuid()) @db.Uuid
  invoiceId          String @map("invoice_id") @db.Uuid
  invoice            PaymentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  provider           String
  environment        String
  merchantCode       String @map("merchant_code")
  serviceCode        String @map("service_code")
  merchantReference  String @unique @map("merchant_reference") @db.Uuid
  providerReference  String? @map("provider_reference")
  method             String
  amountMinor        Int @map("amount_minor")
  currency           String
  status             String
  settlementStatus   String @default("UNRECONCILED") @map("settlement_status")
  hostedUrl          String? @map("hosted_url")
  expiresAt          DateTime @map("expires_at") @db.Timestamptz
  nextCheckAt        DateTime @map("next_check_at") @db.Timestamptz
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  settledAt          DateTime? @map("settled_at") @db.Timestamptz
  settlementReference String? @unique @map("settlement_reference")
  settlementEvidence String? @map("settlement_evidence")
  settledById        String? @map("settled_by_id") @db.Uuid
  feeMinor           Int? @map("fee_minor")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  events             CollectionEvent[]
  @@unique([provider, environment, merchantCode, providerReference], map: "collection_attempts_provider_ref_key")
  @@index([invoiceId, createdAt])
  @@index([environment, status, nextCheckAt])
  @@map("collection_attempts")
}

model CollectionEvent {
  id        String @id @default(uuid()) @db.Uuid
  attemptId String @map("attempt_id") @db.Uuid
  attempt   CollectionAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  dedupeKey String @unique @map("dedupe_key")
  kind      String
  result    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("collection_events")
}

model PaymentRoutingPolicy {
  environment String @id
  version     Int @default(0)
  enabled     Boolean @default(false)
  methods     String[]
  minMinor    Int @map("min_minor")
  maxMinor    Int @map("max_minor")
  evidence    String
  feeTerms    String @map("fee_terms")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@map("payment_routing_policies")
}

/**
 * ============================================================== REVIEWS ==
 */

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  /// Reviews hang off a booking, so only real customers can leave one.
  bookingId   String       @unique @map("booking_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  serviceType ServiceType  @map("service_type")
  resourceId  String       @map("resource_id") @db.Uuid
  rating      Int          @db.SmallInt
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([serviceType, resourceId])
  @@index([status])
  @@map("reviews")
}

/**
 * ======================================================== NOTIFICATIONS ==
 */

model Notification {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  /// e.g. booking.confirmed, payment.received, provider.approved
  type   String
  title  String
  body   String?
  /// Deep link into the relevant dashboard page.
  href   String?

  channel   String    @default("email")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  sentAt    DateTime? @map("sent_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
  @@map("notifications")
}

/**
 * ===================================================== TRANSFER ROUTES ==
 */

/// How a transfer route starts. Drives the icon shown beside it.
enum TransferMode {
  AIRPORT
  RAIL
  ROAD
}

/// Which price table a zone belongs to. Nairobi zones are priced from JKIA and serve the Nairobi SGR too.
enum TransferOrigin {
  KIGALI
  MUSANZE
  RUBAVU
  BETWEEN_TOWNS
}

/// A zone price: one or more areas, one fixed price per vehicle type, either direction.
model TransferZone {
  id           String         @id @default(uuid()) @db.Uuid
  origin       TransferOrigin
  /// "Zone 2 · Central Nairobi". Rows sharing a name are grouped together on the site.
  name         String
  /// Comma-separated estates or towns; each one is a choice in the area list.
  areas        String
  /// "15–18 km", shown beside the zone.
  distance     String?
  sedanMinor   Int            @map("sedan_minor")
  vanMinor     Int            @map("van_minor")
