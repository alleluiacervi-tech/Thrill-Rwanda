enum TicketingStatus {
  OPTIONS
  AWAITING_PAYMENT
  READY_TO_TICKET
  TICKETING
  ISSUED
  CLOSED
  CANCELLED
}

/// One air-ticketing file per flight enquiry. Tickets are issued by the contracted partner; staff record the evidence.
model FlightTicketing {
  id String @id @default(uuid()) @db.Uuid
  enquiryId String @unique @map("enquiry_id") @db.Uuid
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  status TicketingStatus @default(OPTIONS)
  version Int @default(0)
  partner String @default("")
  optionsSharedAt DateTime? @map("options_shared_at") @db.Timestamptz
  ticketTimeLimit DateTime? @map("ticket_time_limit") @db.Timestamptz
  pnr String?
  partnerReference String? @map("partner_reference")
  /// Set when the booking was made through an API supplier rather than by hand.
  externalProvider String? @map("external_provider")
  externalOrderId String? @map("external_order_id")
  /// ATTEMPTING while a booking request is in flight or its outcome is unknown; BOOKED; FAILED.
  externalStatus String? @map("external_status")
  externalAttemptAt DateTime? @map("external_attempt_at") @db.Timestamptz
  issuanceEvidence String? @map("issuance_evidence")
  issuedAt DateTime? @map("issued_at") @db.Timestamptz
  issuedById String? @map("issued_by_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  redactedAt DateTime? @map("redacted_at") @db.Timestamptz
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  options FlightOption[]
  passengers FlightPassenger[]
  requests FlightServiceRequest[]
  @@index([status, ticketTimeLimit])
  @@map("flight_ticketing")
}

model FlightOption {
  id String @id @default(uuid()) @db.Uuid
  ticketingId String @map("ticketing_id") @db.Uuid
  ticketing FlightTicketing @relation(fields: [ticketingId], references: [id], onDelete: Cascade)
  position Int
  label String
  currency String
  totalMinor Int @map("total_minor")
  fareBasis String @default("") @map("fare_basis")
  baggage String @default("")
  changeRule String @default("") @map("change_rule")
  refundRule String @default("") @map("refund_rule")
  validUntil DateTime @map("valid_until") @db.Timestamptz
  selected Boolean @default(false)
  /// MANUAL = typed in by the desk; DUFFEL = a live fare from the Duffel API, bookable through it.
  source String @default("MANUAL")
  /// The supplier's own id for this fare (a Duffel offer id), kept so it can be re-priced and booked.
  externalId String? @map("external_id")
  segments FlightSegment[]
  @@unique([ticketingId, position])
  @@map("flight_options")
}

model FlightSegment {
  id String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  option FlightOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  position Int
  airline String
  flightNumber String @map("flight_number")
  origin String
  destination String
  /// Airport-local wall-clock times as YYYY-MM-DDTHH:mm so no time zone is guessed.
  departLocal String @map("depart_local")
  arriveLocal String @map("arrive_local")
  cabin String @default("ECONOMY")
  bookingClass String @default("") @map("booking_class")
  terminal String @default("")
  @@unique([optionId, position])
  @@map("flight_segments")
}

model FlightPassenger {
  id String @id @default(uuid()) @db.Uuid
  ticketingId String @map("ticketing_id") @db.Uuid
  ticketing FlightTicketing @relation(fields: [ticketingId], references: [id], onDelete: Cascade)
  position Int
  kind String @default("ADULT")
  title String @default("")
  givenNames String @map("given_names")
  surname String
  /// Travel-document details are cleared after the trip by the retention job.
  dateOfBirth String? @map("date_of_birth")
  nationality String?
  documentNumber String? @map("document_number")
  documentExpiry String? @map("document_expiry")
  ticketNumber String? @unique @map("ticket_number")
  previousTickets String[] @map("previous_tickets")
  ticketedAt DateTime? @map("ticketed_at") @db.Timestamptz
  status String @default("ACTIVE")
  @@unique([ticketingId, position])
  @@map("flight_passengers")
}

/// Changes, reissues, voids, refunds and name corrections after ticketing, raised by the client or staff.
model FlightServiceRequest {
  id String @id @default(uuid()) @db.Uuid
  ticketingId String @map("ticketing_id") @db.Uuid
  ticketing FlightTicketing @relation(fields: [ticketingId], references: [id], onDelete: Restrict)
  number Int
  kind String
  status String @default("REQUESTED")
  origin String @default("STAFF")
  requestedById String? @map("requested_by_id") @db.Uuid
  description String
  passengerIds String[] @map("passenger_ids")
  partnerEvidence String? @map("partner_evidence")
  currency String?
  feeMinor Int @default(0) @map("fee_minor")
  refundMinor Int @default(0) @map("refund_minor")
  resolution String?
  closedById String? @map("closed_by_id") @db.Uuid
  closedAt DateTime? @map("closed_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@unique([ticketingId, number])
  @@index([status, createdAt])
  @@map("flight_service_requests")
}

/// The lowest fare a daily check found for one route and date (src/lib/fare-watch.ts).
/// Only live Duffel results are stored; the public fares board reads these rows.
model FareSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  origin        String
  destination   String
  departureDate DateTime @map("departure_date") @db.Date
  cabin         String   @default("ECONOMY")
  currency      String
  totalMinor    Int      @map("total_minor")
  airline       String   @default("")
  /// -1: connecting, number of stops not given (Skyscanner only says direct or not).
  stops         Int      @default(0)
  /// manual | duffel | skyscanner. The board shows only the source chosen in Admin → Fares.
  source        String   @default("duffel")
  /// Manual fares only: the desk's own date after which the fare leaves the board.
  validUntil    DateTime? @map("valid_until") @db.Timestamptz
  /// Manual fares only: a short line shown under the fare, which also lists it under Best deals.
  dealNote      String?  @map("deal_note")
  /// When the price was found: our search time for Duffel, the quote's own time for Skyscanner.
  checkedAt     DateTime @default(now()) @map("checked_at") @db.Timestamptz
  @@index([destination, checkedAt])
  @@index([checkedAt])
  @@map("fare_snapshots")
}
